# Backend API URL
VITE_API_URL=http://localhost:8000

# OSRM routing server used to draw road-following paths on the schedule map.
# Defaults to the public demo server, which is rate limited and explicitly not
# for production use - point this at your own OSRM instance before shipping.
VITE_OSRM_URL=https://router.project-osrm.org
